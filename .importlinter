[importlinter]
root_package = teabot
include_external_packages = True

# Aktivieren, sobald bot/ und web/ existieren (v0.2.0)
# [importlinter:contract:schichten]
# name = Schichtenreihenfolge
# type = layers
# layers =
#     teabot.app
#     teabot.modules
#     teabot.web : teabot.bot
#     teabot.core : teabot.db
#     teabot.config

[importlinter:contract:core-kennt-keine-module]
name = core kennt keine Module
type = forbidden
source_modules =
    teabot.core
    teabot.db
forbidden_modules =
    teabot.modules

# Aktivieren, sobald bot/ existiert (v0.2.0)
